---
export interface Props {
  name: string;
  url: string;
  store: 'amazon' | 'walmart';
  description?: string;
}

const { name, url, store, description } = Astro.props;

const storeLabel = store === 'amazon' ? 'Amazon' : 'Walmart';
---

<div class="flex items-start justify-between gap-6 py-3 border-b border-stone last:border-0">
  <div class="flex-1 min-w-0">
    <p class="text-sm font-medium text-ink">{name}</p>
    {description && <p class="text-xs text-ink-muted mt-0.5">{description}</p>}
  </div>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer sponsored"
    class="flex-shrink-0 text-xs text-leaf hover:text-forest font-medium whitespace-nowrap transition-colors"
  >
    → {storeLabel} ↗
  </a>
</div>
